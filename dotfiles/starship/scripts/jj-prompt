#!/usr/bin/env python3
"""
jj-prompt: Starship prompt module for Jujutsu repositories.
Replaces jj-starship using the jj CLI to remain backend-agnostic.

The rendered prompt is cached against a fingerprint built from purely local
files, so the common case never spawns `jj`. On a cache miss the prompt blocks
until `jj` returns: the prompt is always correct, never stale, at the cost of
an occasional ~175ms pause.

Commands:
  prompt   render the prompt (default)
  detect   exit 0 if in a JJ repo
  offline  render using ONLY local files - zero RPC, zero cache
  refresh  recompute the cache (use to pre-warm)
  bench    report timings for each path
"""

import os
import sys

# ANSI Colors
BLUE = "\033[34m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
DIM = "\033[2m"
RESET = "\033[0m"

# Configuration defaults (compatible with jj-starship environment variables)
DEFAULT_SYMBOL = "󱗆 "
DEFAULT_DISPLAY_LIMIT = 3
DEFAULT_STRIP_PREFIX = ""
DEFAULT_TRUNCATE_LEN = 0

# Seconds before a cache entry is considered stale. This is a backstop for
# state changes the fingerprint cannot observe, e.g. `jj bookmark set` moving a
# bookmark without touching the working copy. 0 disables the TTL.
DEFAULT_TTL = float(os.environ.get("JJ_PROMPT_TTL", "30"))


def find_repo_root(start_dir="."):
    """Walk up the directory tree looking for a .jj directory. Returns path or None."""
    curr = os.path.abspath(start_dir)
    while True:
        if os.path.isdir(os.path.join(curr, ".jj")):
            return curr
        parent = os.path.dirname(curr)
        if parent == curr:
            break
        curr = parent
    # Retry through symlinks, which is how some checkouts are laid out.
    real = os.path.realpath(start_dir)
    if real != os.path.abspath(start_dir):
        curr = real
        while True:
            if os.path.isdir(os.path.join(curr, ".jj")):
                return curr
            parent = os.path.dirname(curr)
            if parent == curr:
                break
            curr = parent
    return None


def is_jj_repo(start_dir="."):
    return find_repo_root(start_dir) is not None


# ---------------------------------------------------------------------------
# Fingerprint
#
# .jj/working_copy/checkout is a CitcCheckoutState proto on CitC
# (//depot/google3/devtools/jj/common/proto/citc.proto) and a Checkout proto on
# OSS backends. Both embed the operation id, so the bytes change whenever the
# repo state the prompt cares about changes.
#
# We deliberately hash nothing and parse nothing here: the raw bytes ARE the
# fingerprint. If the proto layout ever changes, the bytes still differ, so we
# degrade to a cache miss rather than to a wrong prompt.
# ---------------------------------------------------------------------------


def fingerprint(repo_root):
    """Cheap local fingerprint of repo state. Returns a short str, or None."""
    parts = []
    try:
        with open(os.path.join(repo_root, ".jj/working_copy/checkout"), "rb") as f:
            parts.append(f.read().hex())
    except OSError:
        return None
    # OSS backends keep op heads as filenames; cheap extra signal, absent on CitC.
    try:
        heads = sorted(os.listdir(os.path.join(repo_root, ".jj/repo/op_heads/heads")))
        parts.extend(heads)
    except OSError:
        pass
    return ":".join(parts)


def cache_path(repo_root):
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    # Avoid hashlib (import cost on the hot path); the path itself is a fine key.
    key = repo_root.strip("/").replace("/", "%") or "root"
    return os.path.join(base, "jj-prompt", key)


def cache_read(repo_root):
    """Returns (fingerprint, timestamp, output) or (None, 0, None)."""
    try:
        with open(cache_path(repo_root), "r", encoding="utf-8") as f:
            fp, ts, out = f.read().split("\n", 2)
        return fp, float(ts), out
    except (OSError, ValueError):
        return None, 0.0, None


def cache_write(repo_root, fp, output):
    import time

    path = cache_path(repo_root)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        # Atomic: a concurrent reader sees either the old or the new entry.
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(f"{fp}\n{time.time()}\n{output}")
        os.replace(tmp, path)
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Minimal protobuf reader, for the offline path only.
# ---------------------------------------------------------------------------


def _varint(buf, i):
    val = shift = 0
    while i < len(buf):
        b = buf[i]
        i += 1
        val |= (b & 0x7F) << shift
        if not b & 0x80:
            return val, i
        shift += 7
    return val, i


def _fields(buf):
    """Parse a protobuf message into {field_number: [value, ...]}."""
    out = {}
    i = 0
    while i < len(buf):
        key, i = _varint(buf, i)
        fnum, wire = key >> 3, key & 7
        if wire == 0:
            val, i = _varint(buf, i)
        elif wire == 2:
            n, i = _varint(buf, i)
            val, i = buf[i : i + n], i + n
        elif wire == 5:
            val, i = buf[i : i + 4], i + 4
        elif wire == 1:
            val, i = buf[i : i + 8], i + 8
        else:
            break
        out.setdefault(fnum, []).append(val)
    return out


def read_checkout_state(repo_root):
    """Parse .jj/working_copy/checkout. Returns dict of locally-known state."""
    try:
        with open(os.path.join(repo_root, ".jj/working_copy/checkout"), "rb") as f:
            msg = _fields(f.read())
    except OSError:
        return {}

    def _nested_id(fnum):
        # OperationId / CommitId are messages wrapping `bytes id = 1`.
        vals = msg.get(fnum)
        if not vals or not isinstance(vals[0], (bytes, bytearray)):
            return None
        inner = _fields(vals[0]).get(1)
        return inner[0].hex() if inner else None

    def _str(fnum):
        vals = msg.get(fnum)
        if not vals or not isinstance(vals[0], (bytes, bytearray)):
            return None
        return vals[0].decode("utf-8", "replace")

    baseline = msg.get(3, [None])[0]
    return {
        "operation_id": _nested_id(1),
        "workspace_name": _str(2),
        "baseline_cl": baseline if isinstance(baseline, int) else None,
        "branch_name": _str(4),
        "commit_id": _nested_id(5),
    }


# Format each commit along the path as a tab-separated line:
# kind (WC or BM) \t change_id \t status_flags \t bookmarks (with ⇡ if unsynced)
JJ_LOG_TEMPLATE = r"""
if(self.contained_in("@"), "WC", "BM") ++ "\t" ++
change_id.shortest(8) ++ "\t" ++
if(conflict, "!") ++ if(divergent, "⇔") ++ if(!empty && !description, "∅") ++ "\t" ++
local_bookmarks.map(|b| b.name() ++ if(!b.synced(), "⇡")).join(",") ++ "\n"
""".strip()

JJ_LOG_CMD = (
    "jj",
    "log",
    "-r",
    "present(@) | (heads(::@ & bookmarks())::@)",
    "--no-graph",
    "--ignore-working-copy",
    "--color",
    "always",
    "-T",
    JJ_LOG_TEMPLATE,
)


class FastArgs:
    """Config from env vars only, so the hot path never imports argparse.

    argparse costs ~7ms (it pulls in `re`), which is an order of magnitude more
    than the entire cache-hit lookup. Bare `jj-prompt` / `jj-prompt prompt`
    therefore bypasses it; any flag falls back to the real parser.
    """

    __slots__ = (
        "command",
        "truncate_name",
        "bookmarks_display_limit",
        "strip_bookmark_prefix",
        "jj_symbol",
        "no_cache",
        "ttl",
    )

    def __init__(self, command="prompt"):
        env = os.environ.get
        self.command = command
        self.truncate_name = int(env("JJ_STARSHIP_TRUNCATE_NAME", DEFAULT_TRUNCATE_LEN))
        self.bookmarks_display_limit = int(
            env("JJ_STARSHIP_BOOKMARKS_DISPLAY_LIMIT", DEFAULT_DISPLAY_LIMIT)
        )
        self.strip_bookmark_prefix = env("JJ_STARSHIP_STRIP_BOOKMARK_PREFIX", DEFAULT_STRIP_PREFIX)
        self.jj_symbol = env("JJ_STARSHIP_JJ_SYMBOL", DEFAULT_SYMBOL)
        self.no_cache = False
        self.ttl = DEFAULT_TTL


def parse_args(argv=None):
    import argparse

    parser = argparse.ArgumentParser(
        description="Starship prompt module for Jujutsu repositories."
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="prompt",
        choices=["prompt", "detect", "offline", "refresh", "bench"],
        metavar="COMMAND",
        help="Command: 'prompt' (default), 'detect', 'offline', 'refresh', 'bench'",
    )
    parser.add_argument(
        "--truncate-name",
        type=int,
        metavar="TRUNCATE_NAME",
        default=int(os.environ.get("JJ_STARSHIP_TRUNCATE_NAME", DEFAULT_TRUNCATE_LEN)),
        help="Max length for branch/bookmark name (0 = unlimited)",
    )
    parser.add_argument(
        "--bookmarks-display-limit",
        type=int,
        metavar="BOOKMARKS_DISPLAY_LIMIT",
        default=int(os.environ.get("JJ_STARSHIP_BOOKMARKS_DISPLAY_LIMIT", DEFAULT_DISPLAY_LIMIT)),
        help="Max bookmarks to display (0 = unlimited, default: 3)",
    )
    parser.add_argument(
        "--strip-bookmark-prefix",
        metavar="STRIP_BOOKMARK_PREFIX",
        default=os.environ.get("JJ_STARSHIP_STRIP_BOOKMARK_PREFIX", DEFAULT_STRIP_PREFIX),
        help="Prefixes to strip from bookmark names (comma-separated)",
    )
    parser.add_argument(
        "--jj-symbol",
        metavar="JJ_SYMBOL",
        default=os.environ.get("JJ_STARSHIP_JJ_SYMBOL", DEFAULT_SYMBOL),
        help="Symbol prefix for JJ repos",
    )
    parser.add_argument(
        "--no-cache",
        action="store_true",
        help="Bypass the cache and always shell out to jj",
    )
    parser.add_argument(
        "--ttl",
        type=float,
        default=DEFAULT_TTL,
        help="Seconds before a cache entry is considered stale (0 = never)",
    )
    return parser.parse_args(argv)


def render(args):
    """Shell out to jj and render the prompt string. Returns str or None."""
    import re
    import subprocess

    ansi_re = re.compile(r"\x1b\[[0-9;]*m")

    try:
        res = subprocess.run(JJ_LOG_CMD, capture_output=True, text=True, check=True)
    except Exception:
        return None

    lines = [line.split("\t") for line in res.stdout.strip().splitlines() if line]
    if not lines:
        return None

    # First line is always the working copy (@)
    row0 = lines[0] + [""] * (4 - len(lines[0]))
    _wc_kind, wc_cid, wc_status, wc_bms = row0[:4]
    wc_bms = ansi_re.sub("", wc_bms)

    # Collect bookmarks:
    # 1. Direct bookmarks on @ (distance 0)
    bookmarks = []
    if wc_bms:
        bookmarks.extend(b for b in wc_bms.split(",") if b)

    # 2. Ancestor bookmarks (lines are newest-to-oldest; index = commit distance)
    for dist, row in enumerate(lines[1:], start=1):
        if len(row) >= 4 and row[3]:
            clean_bms = ansi_re.sub("", row[3])
            for bm in clean_bms.split(","):
                if bm:
                    bookmarks.append(f"{bm}~{dist}")

    # Apply prefix stripping & truncation
    strip_prefixes = (
        [p for p in args.strip_bookmark_prefix.split(",") if p]
        if args.strip_bookmark_prefix
        else []
    )
    formatted_bms = []
    for bm in bookmarks:
        name = bm
        for prefix in strip_prefixes:
            if name.startswith(prefix):
                name = name[len(prefix) :]
                break
        if args.truncate_name > 0 and len(name) > args.truncate_name:
            name = name[: args.truncate_name] + "…"
        formatted_bms.append(name)

    # Format bookmark list with overflow indicator (…+N)
    if formatted_bms:
        shown = (
            formatted_bms[: args.bookmarks_display_limit]
            if args.bookmarks_display_limit > 0
            else formatted_bms
        )
        overflow = len(formatted_bms) - len(shown)
        bm_text = ", ".join(shown)
        if overflow > 0:
            bm_text += f", …+{overflow}"
        bm_part = f" {GREEN}({bm_text}){RESET}"
    else:
        bm_part = ""

    # Format status flags ([!] [⇔] [∅])
    if wc_status:
        color = YELLOW if wc_status == "∅" else RED
        status_part = f" {color}[{wc_status}]{RESET}"
    else:
        status_part = ""

    return f"on {BLUE}{args.jj_symbol}{RESET}{wc_cid}{bm_part}{status_part}"


def render_offline(repo_root, args):
    """Render using only local files. No jj, no RPC, no cache.

    Cannot show change id or pending cl/NNN bookmarks: those live in the
    backend. Shows what the working copy records locally instead.
    """
    st = read_checkout_state(repo_root)
    if not st or not st.get("commit_id"):
        return None

    ident = st["commit_id"][:8]
    parts = []
    if st.get("branch_name"):
        parts.append(st["branch_name"])
    if st.get("baseline_cl"):
        parts.append(f"cl/{st['baseline_cl']}")
    suffix = f" {GREEN}({', '.join(parts)}){RESET}" if parts else ""
    return f"on {BLUE}{args.jj_symbol}{RESET}{DIM}{ident}{RESET}{suffix}"


def cached_render(args, repo_root):
    """Return the prompt string, using the cache when it is fresh.

    On a miss this blocks on `jj`, so the returned value is never stale.
    """
    if args.no_cache:
        return render(args)

    import time

    fp = fingerprint(repo_root)
    cached_fp, ts, cached_out = cache_read(repo_root)
    if (
        fp is not None
        and cached_fp == fp
        and cached_out is not None
        and (args.ttl <= 0 or time.time() - ts < args.ttl)
    ):
        return cached_out

    out = render(args)
    if out is not None and fp is not None:
        cache_write(repo_root, fp, out)
    return out


def cmd_prompt(args):
    # Not being in a repo is the normal case, not an error: starship calls this
    # unconditionally (when = true) so that it does not have to pay for a
    # separate `detect` process. Print nothing and succeed; the module's
    # conditional format group "($output )" then renders nothing at all.
    repo_root = find_repo_root()
    if repo_root is None:
        return
    out = cached_render(args, repo_root)
    if out is None:
        # In a repo but jj failed - a real error, so stay debuggable.
        sys.exit(1)
    print(out, end="")


def cmd_offline(args):
    repo_root = find_repo_root()
    if repo_root is None:
        sys.exit(1)
    out = render_offline(repo_root, args)
    if out is None:
        sys.exit(1)
    print(out, end="")


def cmd_refresh(args):
    repo_root = find_repo_root()
    if repo_root is None:
        sys.exit(1)
    fp = fingerprint(repo_root)
    out = render(args)
    if out is None:
        sys.exit(1)
    if fp is not None:
        cache_write(repo_root, fp, out)
    print(out, end="")


def cmd_bench(args):
    import subprocess
    import time

    repo_root = find_repo_root()
    if repo_root is None:
        print("not in a jj repo")
        sys.exit(1)

    def t(label, fn, n=20):
        fn()  # warm
        start = time.perf_counter()
        for _ in range(n):
            fn()
        per = (time.perf_counter() - start) / n * 1000
        print(f"  {label:<38} {per:8.3f} ms")

    print(f"repo: {repo_root}")
    try:
        with open(os.path.join(repo_root, ".jj/repo/store/type")) as f:
            print(f"backend: {f.read().strip()}")
    except OSError:
        print("backend: <unknown>")

    print("\nin-process (excludes ~20ms interpreter startup):")
    t("find_repo_root()", lambda: find_repo_root())
    t("fingerprint()", lambda: fingerprint(repo_root))
    t("cache_read()", lambda: cache_read(repo_root))
    t("read_checkout_state()", lambda: read_checkout_state(repo_root))
    t("full cache-hit path", lambda: (fingerprint(repo_root), cache_read(repo_root)))
    t("render_offline()", lambda: render_offline(repo_root, args))
    t("render() [spawns jj]", lambda: render(args), n=5)

    print("\nend-to-end (includes interpreter startup):")
    me = os.path.abspath(__file__)

    def run(argv, n=10):
        start = time.perf_counter()
        for _ in range(n):
            subprocess.run([sys.executable, me] + argv, capture_output=True)
        return (time.perf_counter() - start) / n * 1000

    for label, argv in (
        ("detect", ["detect"]),
        ("prompt (cache hit)", ["prompt"]),
        ("offline", ["offline"]),
        ("prompt --no-cache", ["prompt", "--no-cache"]),
    ):
        n = 5 if "--no-cache" in argv else 10
        print(f"  {label:<38} {run(argv, n):8.3f} ms")


def main():
    argv = sys.argv[1:]

    # Fast paths that skip argparse (~7ms, vs ~0.7ms for the whole cache lookup).
    if argv == ["detect"]:
        sys.exit(0 if is_jj_repo() else 1)
    if not argv or argv == ["prompt"]:
        cmd_prompt(FastArgs("prompt"))
        return
    if argv == ["offline"]:
        cmd_offline(FastArgs("offline"))
        return

    args = parse_args()
    if args.command == "detect":
        sys.exit(0 if is_jj_repo() else 1)
    if args.command == "offline":
        cmd_offline(args)
        return
    if args.command == "refresh":
        cmd_refresh(args)
        return
    if args.command == "bench":
        cmd_bench(args)
        return
    cmd_prompt(args)


if __name__ == "__main__":
    main()
