#!/usr/bin/env python3
"""
jj-prompt: Starship prompt module for Jujutsu repositories.
Replaces jj-starship using the jj CLI to remain backend-agnostic.
"""

import os
import sys

# ANSI Colors
BLUE = "\033[34m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
RESET = "\033[0m"

# Configuration defaults (compatible with jj-starship environment variables)
DEFAULT_SYMBOL = "󱗆 "
DEFAULT_DISPLAY_LIMIT = 3
DEFAULT_STRIP_PREFIX = ""
DEFAULT_TRUNCATE_LEN = 0


def is_jj_repo(start_dir="."):
    """Walk up the directory tree to check if a .jj directory exists."""
    curr = os.path.abspath(start_dir)
    while True:
        if os.path.isdir(os.path.join(curr, ".jj")):
            return True
        parent = os.path.dirname(curr)
        if parent == curr:
            break
        curr = parent
    real = os.path.realpath(start_dir)
    if real != os.path.abspath(start_dir):
        curr = real
        while True:
            if os.path.isdir(os.path.join(curr, ".jj")):
                return True
            parent = os.path.dirname(curr)
            if parent == curr:
                break
            curr = parent
    return False


# Format each commit along the path as a tab-separated line:
# kind (WC or BM) \t change_id \t status_flags \t bookmarks (with ⇡ if unsynced)
JJ_LOG_TEMPLATE = r"""
if(self.contained_in("@"), "WC", "BM") ++ "\t" ++
change_id.shortest(8) ++ "\t" ++
if(conflict, "!") ++ if(divergent, "⇔") ++ if(!empty && !description, "∅") ++ "\t" ++
local_bookmarks.map(|b| b.name() ++ if(!b.synced(), "⇡")).join(",") ++ "\n"
""".strip()

JJ_LOG_CMD = (
    "jj",
    "log",
    "-r",
    "present(@) | (heads(::@ & bookmarks())::@)",
    "--no-graph",
    "--ignore-working-copy",
    "--color",
    "always",
    "-T",
    JJ_LOG_TEMPLATE,
)


def parse_args(argv=None):
    import argparse

    parser = argparse.ArgumentParser(
        description="Starship prompt module for Jujutsu repositories."
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="prompt",
        choices=["prompt", "detect"],
        metavar="COMMAND",
        help="Command: 'prompt' (default) or 'detect' (exit 0 if in JJ repo, 1 otherwise)",
    )
    parser.add_argument(
        "--truncate-name",
        type=int,
        metavar="TRUNCATE_NAME",
        default=int(os.environ.get("JJ_STARSHIP_TRUNCATE_NAME", DEFAULT_TRUNCATE_LEN)),
        help="Max length for branch/bookmark name (0 = unlimited)",
    )
    parser.add_argument(
        "--bookmarks-display-limit",
        type=int,
        metavar="BOOKMARKS_DISPLAY_LIMIT",
        default=int(os.environ.get("JJ_STARSHIP_BOOKMARKS_DISPLAY_LIMIT", DEFAULT_DISPLAY_LIMIT)),
        help="Max bookmarks to display (0 = unlimited, default: 3)",
    )
    parser.add_argument(
        "--strip-bookmark-prefix",
        metavar="STRIP_BOOKMARK_PREFIX",
        default=os.environ.get("JJ_STARSHIP_STRIP_BOOKMARK_PREFIX", DEFAULT_STRIP_PREFIX),
        help="Prefixes to strip from bookmark names (comma-separated)",
    )
    parser.add_argument(
        "--jj-symbol",
        metavar="JJ_SYMBOL",
        default=os.environ.get("JJ_STARSHIP_JJ_SYMBOL", DEFAULT_SYMBOL),
        help="Symbol prefix for JJ repos",
    )
    return parser.parse_args(argv)


def main():
    # Fast path for "jj-prompt detect" to minimize prompt latency (avoids importing re, subprocess, argparse)
    if len(sys.argv) == 2 and sys.argv[1] == "detect":
        sys.exit(0 if is_jj_repo() else 1)

    args = parse_args()
    if args.command == "detect":
        sys.exit(0 if is_jj_repo() else 1)

    import re
    import subprocess

    ansi_re = re.compile(r"\x1b\[[0-9;]*m")

    try:
        res = subprocess.run(JJ_LOG_CMD, capture_output=True, text=True, check=True)
    except Exception:
        # Silent exit (code 1) if outside a JJ repo or on jj error
        sys.exit(1)

    lines = [line.split("\t") for line in res.stdout.strip().splitlines() if line]
    if not lines:
        sys.exit(1)

    # First line is always the working copy (@)
    row0 = lines[0] + [""] * (4 - len(lines[0]))
    _wc_kind, wc_cid, wc_status, wc_bms = row0[:4]
    wc_bms = ansi_re.sub("", wc_bms)

    # Collect bookmarks:
    # 1. Direct bookmarks on @ (distance 0)
    bookmarks = []
    if wc_bms:
        bookmarks.extend(b for b in wc_bms.split(",") if b)

    # 2. Ancestor bookmarks (lines are newest-to-oldest; index = commit distance)
    for dist, row in enumerate(lines[1:], start=1):
        if len(row) >= 4 and row[3]:
            clean_bms = ansi_re.sub("", row[3])
            for bm in clean_bms.split(","):
                if bm:
                    bookmarks.append(f"{bm}~{dist}")

    # Apply prefix stripping & truncation
    strip_prefixes = (
        [p for p in args.strip_bookmark_prefix.split(",") if p]
        if args.strip_bookmark_prefix
        else []
    )
    formatted_bms = []
    for bm in bookmarks:
        name = bm
        for prefix in strip_prefixes:
            if name.startswith(prefix):
                name = name[len(prefix) :]
                break
        if args.truncate_name > 0 and len(name) > args.truncate_name:
            name = name[: args.truncate_name] + "…"
        formatted_bms.append(name)

    # Format bookmark list with overflow indicator (…+N)
    if formatted_bms:
        shown = (
            formatted_bms[: args.bookmarks_display_limit]
            if args.bookmarks_display_limit > 0
            else formatted_bms
        )
        overflow = len(formatted_bms) - len(shown)
        bm_text = ", ".join(shown)
        if overflow > 0:
            bm_text += f", …+{overflow}"
        bm_part = f" {GREEN}({bm_text}){RESET}"
    else:
        bm_part = ""

    # Format status flags ([!] [⇔] [∅])
    if wc_status:
        color = YELLOW if wc_status == "∅" else RED
        status_part = f" {color}[{wc_status}]{RESET}"
    else:
        status_part = ""

    # Output prompt string
    output = f"on {BLUE}{args.jj_symbol}{RESET}{wc_cid}{bm_part}{status_part}"
    print(output, end="")


if __name__ == "__main__":
    main()
